{
  "name": "violet-audio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build:harness": "vite build --config tests/harness/vite.config.ts",
    "test:e2e": "npm run build:harness && node tests/audio-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "build:popup": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
